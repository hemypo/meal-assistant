generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String?
  name             String?
  createdAt        DateTime          @default(now())
  products         Product[]
  categoryMappings CategoryMapping[]
}

// ------- Module 1: Inventory / Shopping list -------

enum ProductStatus {
  IN_STOCK // «В наличии»
  TO_BUY // «Надо купить»
}

model Product {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  String        @default("Другое")
  status    ProductStatus @default(TO_BUY)
  quantity  Decimal       @default(1)
  unit      String        @default("шт")
  estPrice  Decimal?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, status])
  @@index([userId, category])
}

// Learned name→category cache: each product name is classified by AI once, ever.
// This is the cost-control table (master plan §6.5) — bulk-adding N products
// triggers one AI call for unknown names only.
model CategoryMapping {
  id             String  @id @default(cuid())
  userId         String?
  user           User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  normalizedName String
  category       String

  @@unique([userId, normalizedName])
}
